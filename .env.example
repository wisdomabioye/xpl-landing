# Contact form (EmailJS — https://www.emailjs.com)
# All three required for the form to actually send. Without them the form
# shows a "Form not configured" notice instead of submitting.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public contact channels — leave blank to hide that channel from the UI.
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_CALENDLY_URL=

# Social links — leave blank to hide an icon from the footer.
VITE_SOCIAL_X=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_LINKEDIN=
